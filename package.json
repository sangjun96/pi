{
  "name": "my-pi-package",
  "version": "0.1.0",
  "description": "Reusable Pi package starter",
  "type": "module",
  "files": [
    "extensions/",
    "prompts/",
    "skills/",
    "scripts/",
    "test/",
    "AGENTS.md",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "vitest.config.ts"
  ],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "test": "vitest run"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/setup-package.ts",
      "./extensions/agents-md.ts",
      "./extensions/mcp.ts",
      "./extensions/permission-gate.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
